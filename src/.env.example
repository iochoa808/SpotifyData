# Copy to src/.env and fill in. src/.env is gitignored; never commit real values.
# CLIENT_ID / CLIENT_SECRET come from https://developer.spotify.com/dashboard
# REFRESH_TOKEN comes from: python src/auth_catch.py
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# Must match a redirect URI registered on the app, verbatim. Spotify rejects
# `localhost`; use the loopback IP. Only used by src/auth_catch.py.
REDIRECT_URI=http://127.0.0.1:8888/callback
